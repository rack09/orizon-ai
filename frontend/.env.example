# Solo impostazioni pubbliche: mai chiavi API o password nelle variabili VITE_.
# Sviluppo locale: lasciare commentato per usare il proxy di Vite.
# VITE_API_URL=/api/chat.php

# Produzione sullo stesso dominio, con index.html e chat.php in backend/public:
# creare .env.production prima della build con questa riga senza il cancelletto.
# VITE_API_URL=/chat.php
